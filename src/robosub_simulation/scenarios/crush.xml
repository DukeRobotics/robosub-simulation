  <robot name="crush" fixed="false" self_collisions="false">
    <base_link name="base_link" type="compound" physics="submerged">
      <external_part name="cad_hull" type="model" physics="submerged" buoyant="false">
        <physical>
          <mesh filename="../meshes/crush_collision.obj" scale="1.0" />
          <origin xyz="0 0 0" rpy="0 0 0" />
        </physical>
        <visual>
          <mesh filename="../meshes/crush_visual.obj" scale="1.0" />
          <origin xyz="0 0 0" rpy="0 0 0" />
        </visual>
        <material name="robot_aluminium" />
        <look name="robot_hull" />
        <mass value="14.456331907981701" />
        <inertia xyz="0.0676483754134 0.112294589825 0.148722746298" />
        <cg xyz="-0.0678438517472 0.0264337175238 -0.00780963552351" rpy="-1.5708322557 0.0443752207889 5.85309564832e-05" />
        <hydrodynamics quadratic_drag="0.8 0.8 1" viscous_drag="0.005 0.005 0.005" />
        <compound_transform xyz="0 0 0" rpy="0 0 0" />
      </external_part>
      <internal_part name="buoyancy_proxy" type="sphere" physics="submerged" buoyant="true">
        <dimensions radius="0.15112042878650697" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material name="robot_neutral" />
        <look name="robot_hull" />
        <mass value="1e-06" />
        <compound_transform xyz="-0.0678438517472 0.0264337175238 -0.00780963552351" rpy="0 0 0" />
      </internal_part>
    </base_link>
    <actuator name="front_right" type="thruster">
      <link name="base_link" />
      <origin xyz="0.152156148253 0.226433717524 -0.00780963552351" rpy="0 0 -0.785398163397" />
      <watchdog timeout="0.4" />
      <specs max_setpoint="150.0" inverted_setpoint="false" normalized_setpoint="true" />
      <propeller diameter="0.07" right="true">
        <mesh filename="../meshes/propeller.obj" scale="1.0" />
        <material name="robot_aluminium" />
        <look name="robot_propeller" />
      </propeller>
      <rotor_dynamics type="first_order">
        <time_constant value="0.08" />
      </rotor_dynamics>
      <thrust_model type="quadratic">
        <thrust_coeff value="0.0008888888888888889" />
      </thrust_model>
    </actuator>

<?xml version="1.0"?>
<package format="3">
  <name>robosub_stonefish</name>
  <version>0.1.0</version>
  <description>Stonefish ROS 2 simulator with pool camera views and managed shutdown.</description>
  <maintainer email="hello@duke-robotics.com">Duke Robotics Club</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>stonefish_ros2</depend>
  <depend>image_transport</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
